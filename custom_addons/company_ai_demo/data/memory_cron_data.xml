<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
  <record id="cron_memory_cleanup" model="ir.cron">
    <field name="name">AI Memory: Retention Cleanup</field>
    <field name="model_id" ref="model_ai_memory_cleanup"/>
    <field name="state">code</field>
    <field name="code">model.cron_cleanup()</field>
    <field name="interval_number">1</field>
    <field name="interval_type">days</field>
    <field name="active" eval="True"/>
  </record>
  <record id="cron_memory_fact_embedding" model="ir.cron">
    <field name="name">AI Memory Facts: Local Embedding Queue</field>
    <field name="model_id" ref="model_ai_agent_memory_fact"/>
    <field name="state">code</field>
    <field name="code">model.cron_embed_pending()</field>
    <field name="interval_number">1</field>
    <field name="interval_type">minutes</field>
    <field name="active" eval="True"/>
  </record>
  <record id="cron_memory_fact_extraction" model="ir.cron">
    <field name="name">AI Memory Facts: Candidate Extraction</field>
    <field name="model_id" ref="model_ai_agent_memory_fact_job"/>
    <field name="state">code</field>
    <field name="code">model.process()</field>
    <field name="interval_number">1</field>
    <field name="interval_type">minutes</field>
    <field name="active" eval="True"/>
  </record>
</odoo>
