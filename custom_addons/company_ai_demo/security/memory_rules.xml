<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Ordinary users may read only their own personal memories or memories
       scoped to their own department. The company boundary is explicit so
       this rule remains safe if another permissive rule is later added. -->
  <record id="rule_memory_visibility" model="ir.rule">
    <field name="name">Agent Memory: personal and department scopes</field>
    <field name="model_id" ref="model_ai_agent_memory_record"/>
    <field name="domain_force">['&amp;', ('company_id', 'in', company_ids), '|', '&amp;', ('scope', '=', 'personal'), ('user_id', '=', user.id), '&amp;', ('scope', '=', 'department'), ('department_id', '=', user.employee_id.department_id.id)]</field>
    <field name="groups" eval="[(4, ref('base.group_user'))]"/>
  </record>

  <record id="rule_memory_company_hr_manager" model="ir.rule">
    <field name="name">Agent Memory: company scope for HR managers</field>
    <field name="model_id" ref="model_ai_agent_memory_record"/>
    <field name="domain_force">['&amp;', ('company_id', 'in', company_ids), '|', ('scope', '=', 'company'), '|', '&amp;', ('scope', '=', 'personal'), ('user_id', '=', user.id), '&amp;', ('scope', '=', 'department'), ('department_id', '=', user.employee_id.department_id.id)]</field>
    <field name="groups" eval="[(4, ref('hr.group_hr_manager'))]"/>
  </record>

  <record id="rule_memory_admin" model="ir.rule">
    <field name="name">Agent Memory: system administrator full company access</field>
    <field name="model_id" ref="model_ai_agent_memory_record"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    <field name="groups" eval="[(4, ref('base.group_system'))]"/>
  </record>
</odoo>
