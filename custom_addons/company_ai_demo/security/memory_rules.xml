<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="rule_memory_visibility" model="ir.rule">
    <field name="name">Agent Memory: visible scopes only</field>
    <field name="model_id" ref="model_ai_agent_memory_record"/>
    <field name="domain_force">['|', ('scope','=','company'), '|', ('scope','=','personal'), ('user_id','=',user.id), '|', ('scope','=','department'), ('department_id','=',user.employee_id.department_id.id)]</field>
    <field name="groups" eval="[(4, ref('base.group_user'))]"/>
  </record>
</odoo>
