<odoo>
    <record id="rule_customer_branding_company" model="ir.rule">
        <field name="name">Customer branding company isolation</field>
        <field name="model_id" ref="model_ai_customer_branding"/>
        <field name="domain_force">[("company_id", "in", company_ids)]</field>
    </record>
    <record id="rule_customer_setup_run_company" model="ir.rule">
        <field name="name">Customer setup run company isolation</field>
        <field name="model_id" ref="model_ai_customer_setup_run"/>
        <field name="domain_force">[("company_id", "in", company_ids)]</field>
    </record>
    <record id="rule_customer_profile_company" model="ir.rule">
        <field name="name">Customer profile company isolation</field>
        <field name="model_id" ref="model_ai_customer_configuration_profile"/>
        <field name="domain_force">[("company_id","in",company_ids)]</field>
    </record>
    <record id="rule_delegation_company" model="ir.rule">
        <field name="name">Delegation company isolation</field>
        <field name="model_id" ref="model_ai_customer_delegation"/>
        <field name="domain_force">[("delegator_id.company_ids","in",company_ids),("delegatee_id.company_ids","in",company_ids)]</field>
    </record>
    <record id="rule_sso_company" model="ir.rule">
        <field name="name">SSO provider company isolation</field>
        <field name="model_id" ref="model_ai_customer_sso_provider"/>
        <field name="domain_force">[("company_id","in",company_ids)]</field>
    </record>
    <record id="rule_scim_company" model="ir.rule">
        <field name="name">SCIM token company isolation</field>
        <field name="model_id" ref="model_ai_customer_scim_token"/>
        <field name="domain_force">[("company_id","in",company_ids)]</field>
    </record>
    <record id="rule_scim_group_company" model="ir.rule">
        <field name="name">SCIM group mappings are company scoped</field>
        <field name="model_id" ref="model_ai_customer_scim_group"/>
        <field name="domain_force">[("company_id", "in", company_ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
    </record>
    <record id="rule_role_assignment_company" model="ir.rule">
        <field name="name">Role assignment company isolation</field>
        <field name="model_id" ref="model_ai_customer_role_assignment"/>
        <field name="domain_force">[("company_id", "in", company_ids)]</field>
    </record>
    <record id="rule_external_identity_company" model="ir.rule"><field name="name">External identity company isolation</field><field name="model_id" ref="model_ai_customer_external_identity"/><field name="domain_force">[("company_id", "in", company_ids)]</field></record>
</odoo>
