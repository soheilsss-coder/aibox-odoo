<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="ai_schedule_rule_view_list" model="ir.ui.view">
        <field name="name">ai.schedule.rule.list</field>
        <field name="model">ai.schedule.rule</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'ok'" decoration-danger="state == 'error'">
                <field name="name"/>
                <field name="user_id"/>
                <field name="interval_number"/>
                <field name="interval_type"/>
                <field name="state"/>
                <field name="last_run_datetime"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="ai_schedule_rule_view_form" model="ir.ui.view">
        <field name="name">ai.schedule.rule.form</field>
        <field name="model">ai.schedule.rule</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_disable" type="object" string="Disable"
                            invisible="not active"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="prompt_text" placeholder="Stored instruction executed each run..."/>
                            <field name="interval_number"/>
                            <field name="interval_type"/>
                            <field name="user_id"/>
                            <field name="notify_user_ids" widget="many2many_tags"/>
                        </group>
                        <group>
                            <field name="state"/>
                            <field name="last_run_datetime"/>
                            <field name="last_result" readonly="1"/>
                            <field name="last_error" readonly="1"/>
                            <field name="cron_id" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="ai_schedule_rule_action" model="ir.actions.act_window">
        <field name="name">Scheduled AI Commands</field>
        <field name="res_model">ai.schedule.rule</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="ai_schedule_rule_menu"
              name="Scheduled AI Commands"
              action="ai_schedule_rule_action"
              parent="base.menu_administration"
              sequence="52"/>

</odoo>