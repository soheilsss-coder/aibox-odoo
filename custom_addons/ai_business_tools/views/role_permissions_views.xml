<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!-- Roadmap #4 (Group) + #6 (Permission): a single summary screen
         answering "what exactly does this Role/Group grant?" without
         reading ir.model.access.csv/ir.rule files by hand.

         This reuses res.groups directly (no new model) - the "table"
         items #4/#6 asked for is just res.groups filtered to the Role
         Templates category (data/role_templates_data.xml, item #5),
         showing each Role's own comment plus the real underlying
         Odoo permission groups (implied_ids) that comment is
         describing, and who currently holds it.

         صادقانه (honest note): این جایگزین کامل «Setup Wizard» نیست
         (که در مورد #4 خودش به آینده حواله شده و در مورد #46 Admin
         Console دوباره اشاره شده) - این یک نمای واقعی و کاربردی روی
         داده‌ی موجوده، نه یک ابزار طراحی گرافیکی جدید. implied_ids
         خودش «سطح دسترسی روی هر منبع» (ir.model.access/ir.rule) را
         مستقیم نشان نمی‌دهد، فقط زنجیره‌ی گروه‌ها را - برای دیدن دقیق
         ACL هر گروه، آن گروه را در نمای استاندارد Users & Companies >
         Groups خود Odoo باز کن؛ این صفحه نقطه‌ی شروع سریع‌تر است، نه
         جایگزین کامل آن نما. -->

    <record id="role_permissions_view_list" model="ir.ui.view">
        <field name="name">role.permissions.overview.list</field>
        <field name="model">res.groups</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false" default_order="name">
                <field name="name" string="Role"/>
                <field name="comment" string="این Role چه دسترسی‌ای می‌دهد"/>
                <field name="implied_ids" string="گروه‌های زیربنایی (implied)" widget="many2many_tags"/>
                <field name="users" string="افراد دارنده‌ی این Role" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <record id="role_permissions_view_form" model="ir.ui.view">
        <field name="name">role.permissions.overview.form</field>
        <field name="model">res.groups</field>
        <field name="arch" type="xml">
            <form create="false" edit="false" delete="false">
                <sheet>
                    <group>
                        <field name="name" string="Role"/>
                        <field name="comment" string="این Role چه دسترسی‌ای می‌دهد"/>
                    </group>
                    <group string="گروه‌های زیربنایی (implied_ids)">
                        <field name="implied_ids" nolabel="1" widget="many2many_tags"/>
                    </group>
                    <group string="افراد دارنده‌ی این Role">
                        <field name="users" nolabel="1" widget="many2many_tags"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="role_permissions_action" model="ir.actions.act_window">
        <field name="name">Role Permissions Overview</field>
        <field name="res_model">res.groups</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('category_id', '=', ref('role_category'))]</field>
        <field name="context">{'create': False}</field>
    </record>

    <menuitem id="role_permissions_menu"
              name="Role Permissions Overview"
              action="role_permissions_action"
              parent="base.menu_administration"
              groups="base.group_system"
              sequence="53"/>

</odoo>
