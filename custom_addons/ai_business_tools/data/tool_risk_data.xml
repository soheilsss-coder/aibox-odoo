<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">

    <!-- RISK 0: read-only -->
    <record id="risk_list_pending_leaves" model="ai.gateway.tool.risk">
        <field name="tool_name">list_pending_leaves</field>
        <field name="risk_level">0</field>
    </record>
    <record id="risk_list_overdue_tasks" model="ai.gateway.tool.risk">
        <field name="tool_name">list_overdue_tasks</field>
        <field name="risk_level">0</field>
    </record>
    <record id="risk_list_documents" model="ai.gateway.tool.risk">
        <field name="tool_name">list_documents</field>
        <field name="risk_level">0</field>
    </record>
    <record id="risk_get_document" model="ai.gateway.tool.risk">
        <field name="tool_name">get_document</field>
        <field name="risk_level">0</field>
    </record>
    <record id="risk_list_elevated_access" model="ai.gateway.tool.risk">
        <field name="tool_name">list_elevated_access</field>
        <field name="risk_level">0</field>
    </record>
    <record id="risk_recall_memory" model="ai.gateway.tool.risk">
        <field name="tool_name">recall_memory</field>
        <field name="risk_level">0</field>
    </record>
    <record id="risk_get_attendance_report" model="ai.gateway.tool.risk">
        <field name="tool_name">get_attendance_report</field>
        <field name="risk_level">0</field>
    </record>
    <record id="risk_check_identity_integrity" model="ai.gateway.tool.risk">
        <field name="tool_name">check_identity_integrity</field>
        <field name="risk_level">0</field>
        <field name="description">Read-only report, roadmap item #1 (Identity)</field>
    </record>
    <record id="risk_list_my_tasks" model="ai.gateway.tool.risk">
        <field name="tool_name">list_my_tasks</field>
        <field name="risk_level">0</field>
        <field name="description">Read-only, hard-scoped to the caller's own tasks - roadmap item #9</field>
    </record>
    <record id="risk_get_my_attendance_summary" model="ai.gateway.tool.risk">
        <field name="tool_name">get_my_attendance_summary</field>
        <field name="risk_level">0</field>
        <field name="description">Read-only, hard-scoped to the caller's own attendance - roadmap item #9</field>
    </record>

    <!-- These five were found MISSING during the v22 merge's own audit
         pass - every one of them existed and worked correctly (all are
         genuinely read-only / self-scoped), they just never got a row
         here, in any of the branches later merged into this tree. That
         meant list_available_tools() (#15) and the Admin Console's
         Agents tab (#46) were both silently incomplete - not a security
         hole (RISK_0 = no gate needed either way), but exactly the kind
         of registry drift #15's whole point is to prevent. -->
    <record id="risk_get_current_datetime" model="ai.gateway.tool.risk">
        <field name="tool_name">get_current_datetime</field>
        <field name="risk_level">0</field>
        <field name="description">Read-only, server clock only - no business data involved</field>
    </record>
    <record id="risk_list_available_tools" model="ai.gateway.tool.risk">
        <field name="tool_name">list_available_tools</field>
        <field name="risk_level">0</field>
        <field name="description">Read-only, reads this very registry - roadmap item #15</field>
    </record>
    <record id="risk_read_attached_file" model="ai.gateway.tool.risk">
        <field name="tool_name">read_attached_file</field>
        <field name="risk_level">0</field>
        <field name="description">Read-only, hard-scoped to attachments already in the caller's own chat thread</field>
    </record>
    <record id="risk_search_internet" model="ai.gateway.tool.risk">
        <field name="tool_name">search_internet</field>
        <field name="risk_level">0</field>
        <field name="description">Read-only, public web search - no internal business data read or mutated</field>
    </record>

    <record id="risk_generic_read" model="ai.gateway.tool.risk">
        <field name="tool_name">generic_read</field>
        <field name="risk_level">0</field>
        <field name="capability_name">odoo.generic.read</field>
        <field name="description">Strict read-only adapter for discovered Odoo models; ACL and record rules remain active.</field>
    </record>

    <!-- RISK 1: low-impact write, affects only the requester themselves -->
    <record id="risk_create_leave_request" model="ai.gateway.tool.risk">
        <field name="tool_name">create_leave_request</field>
        <field name="risk_level">1</field>
        <field name="capability_name">hr.leave.create</field>
    </record>
    <record id="risk_create_task" model="ai.gateway.tool.risk">
        <field name="tool_name">create_task</field>
        <field name="risk_level">1</field>
    </record>
    <record id="risk_save_memory" model="ai.gateway.tool.risk">
        <field name="tool_name">save_memory</field>
        <field name="risk_level">1</field>
    </record>

    <!-- RISK 2: mutation affecting someone else, but reversible / low stakes -->
    <record id="risk_approve_leave" model="ai.gateway.tool.risk">
        <field name="tool_name">approve_leave</field>
        <field name="risk_level">2</field>
        <field name="capability_name">hr.leave.approve</field>
    </record>
    <record id="risk_reject_leave" model="ai.gateway.tool.risk">
        <field name="tool_name">reject_leave</field>
        <field name="risk_level">2</field>
    </record>

    <!-- RISK 3: sensitive, needs a human approver group -->
    <record id="risk_grant_temporary_access" model="ai.gateway.tool.risk">
        <field name="tool_name">grant_temporary_access</field>
        <field name="risk_level">3</field>
        <field name="approver_group_id" ref="role_executive"/>
    </record>
    <record id="risk_analyze_image" model="ai.gateway.tool.risk">
        <field name="tool_name">analyze_image</field>
        <field name="risk_level">0</field>
        <field name="description">Read-only vision analysis, no business data mutation</field>
    </record>

    <!-- RISK 4: high impact (pay/employment) - always needs approval -->
    <record id="risk_generate_hr_decree" model="ai.gateway.tool.risk">
        <field name="tool_name">generate_hr_decree</field>
        <field name="risk_level">4</field>
        <field name="approver_group_id" ref="role_hr_manager"/>
        <field name="description">Already gated via ai.gateway.approval directly in code - this entry documents that, for list_available_tools()</field>
    </record>

    <!-- Phase 2 features (2.2 / 2.8 / 2.4 / 2.5 / 2.7): personal messages,
         meetings, template fills and scheduled commands are writes that
         touch other people or produce documents, but all go through
         Odoo's native models with their own ACL/record rules, so they
         are risk 1-2. The document/report tools create files, never
         mutate sensitive records, hence R1. -->
    <record id="risk_send_personal_message" model="ai.gateway.tool.risk">
        <field name="tool_name">send_personal_message</field>
        <field name="risk_level">2</field>
        <field name="description">Messaging another colleague via native messenger; receiver sees the sender</field>
    </record>
    <record id="risk_schedule_meeting" model="ai.gateway.tool.risk">
        <field name="tool_name">schedule_meeting</field>
        <field name="risk_level">2</field>
        <field name="description">Creates a native calendar.event with attendees and native invitations</field>
    </record>
    <record id="risk_fill_document_template" model="ai.gateway.tool.risk">
        <field name="tool_name">fill_document_template</field>
        <field name="risk_level">1</field>
        <field name="description">Renders an uploaded docx template with HR/payroll field values; output kept as ir.attachment</field>
    </record>
    <record id="risk_generate_qweb_report" model="ai.gateway.tool.risk">
        <field name="tool_name">generate_qweb_report</field>
        <field name="risk_level">1</field>
        <field name="description">Triggers an allowlisted QWeb report render; output kept as ir.attachment</field>
    </record>
    <record id="risk_create_scheduled_command" model="ai.gateway.tool.risk">
        <field name="tool_name">create_scheduled_command</field>
        <field name="risk_level">2</field>
        <field name="description">Creates an ir.cron that periodically runs a stored assistant prompt</field>
    </record>

</odoo>
