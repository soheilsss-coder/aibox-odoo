<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="action_report_hr_directory" model="ir.actions.report">
        <field name="name">HR Staff Directory</field>
        <field name="model">hr.employee</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ai_business_tools.report_hr_directory</field>
        <field name="report_file">ai_business_tools.report_hr_directory</field>
        <field name="print_report_name">'HR Directory - %s' % (object.name or 'Employee')</field>
        <field name="binding_model_id" ref="hr.model_hr_employee"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_hr_directory">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="emp">
                <div class="page" t-attf-style="padding:20px;">
                    <h2>درج کارکنان — HR Directory</h2>
                    <p><strong>نام:</strong> <span t-esc="emp.name or ''"/></p>
                    <p><strong>ایمیل کاری:</strong> <span t-esc="emp.work_email or ''"/></p>
                    <p><strong>کد ملی:</strong> <span t-esc="emp.identification_id or ''"/></p>
                    <p><strong>سمت:</strong> <span t-esc="emp.job_id.name or ''"/></p>
                    <p><strong>واحد سازمانی:</strong> <span t-esc="emp.department_id.name or ''"/></p>
                    <p><strong>سرپرست:</strong> <span t-esc="emp.parent_id.name or ''"/></p>
                    <p><strong>تاریخ تولید:</strong> <span t-esc="time.strftime('%Y-%m-%d')"/></p>
                    <t t-if="'contract_id' in emp._fields and emp.contract_id">
                        <p><strong>آخرین قرارداد / حقوق:</strong>
                            <span t-esc="emp.contract_id.name or ''"/>
                            — <span t-esc="emp.contract_id.wage or 0"/>
                        </p>
                    </t>
                </div>
            </t>
        </t>
    </template>

</odoo>
