<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="rule_access_grant_company_scope" model="ir.rule">
    <field name="name">Temporary access grants are company scoped</field>
    <field name="model_id" ref="model_ai_gateway_access_grant"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    <field name="groups" eval="[(4, ref('base.group_user'))]"/>
  </record>
</odoo>
