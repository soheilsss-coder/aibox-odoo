<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="rule_approval_requester_or_approver" model="ir.rule">
    <field name="name">AI Approval: requester or approver</field>
    <field name="model_id" ref="model_ai_gateway_approval"/>
    <field name="domain_force">['|', ('requested_by_id', '=', user.id), ('approver_group_id', 'in', user.groups_id.ids)]</field>
    <field name="perm_read" eval="True"/><field name="perm_write" eval="True"/><field name="perm_create" eval="False"/><field name="perm_unlink" eval="False"/>
  </record>
</odoo>
