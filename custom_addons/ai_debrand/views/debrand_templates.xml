<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Odoo 18 QWeb template inheritance is the primary white-label path.
         JS remains only as a defense-in-depth fallback for dynamically
         rendered third-party widgets; it is NOT the source of truth. -->
    <template id="debrand_login_layout" inherit_id="web.login_layout">
        <xpath expr="//a[contains(@href, 'odoo.com')]" position="replace">
            <span t-esc="request.env['ir.config_parameter'].sudo().get_param('ai.brand.name') or 'Company AI'"/>
        </xpath>
    </template>

    <template id="debrand_web_layout" inherit_id="web.layout">
        <xpath expr="//title" position="replace">
            <title t-esc="request.env['ir.config_parameter'].sudo().get_param('ai.brand.name') or (title or 'Company AI')"/>
        </xpath>
    </template>

    <!-- Odoo 18: web.assets_frontend/backend are t-call-assets bundles, not
         templates - inheriting them as templates crashes fresh installs
         (ir.model.data KeyError). The JS fallback is wired through the
         manifest "assets" key instead. -->
</odoo>
