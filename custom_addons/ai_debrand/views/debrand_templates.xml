<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Odoo 18 QWeb template inheritance is the primary white-label path.
         JS remains only as a defense-in-depth fallback for dynamically
         rendered third-party widgets; it is NOT the source of truth. -->
    <template id="debrand_login_layout" inherit_id="web.login_layout">
        <xpath expr="//a[contains(@href, 'odoo.com')]" position="replace">
            <span t-esc="request.env['ir.config_parameter'].sudo().get_param('ai.brand.name.%s' % request.env.company.id) or request.env['ir.config_parameter'].sudo().get_param('ai.brand.name') or 'Company AI'"/>
        </xpath>
    </template>

    <template id="debrand_web_layout" inherit_id="web.layout">
        <xpath expr="//title" position="replace">
            <title t-esc="request.env['ir.config_parameter'].sudo().get_param('ai.brand.name.%s' % request.env.company.id) or request.env['ir.config_parameter'].sudo().get_param('ai.brand.name') or (title or 'Company AI')"/>
        </xpath>
    </template>

    <template id="debrand_assets" inherit_id="web.assets_frontend">
        <xpath expr="." position="inside">
            <script type="text/javascript" src="/ai_debrand/static/src/js/debrand.js"/>
        </xpath>
    </template>

    <template id="debrand_assets_backend" inherit_id="web.assets_backend">
        <xpath expr="." position="inside">
            <script type="text/javascript" src="/ai_debrand/static/src/js/debrand.js"/>
        </xpath>
    </template>
</odoo>
