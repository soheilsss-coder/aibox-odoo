  <record id="adapter_sale_management" model="ai.integration.adapter"><field name="module_name">sale_management</field><field name="label">Sales Management</field><field name="capability_prefix">sale.management</field><field name="event_prefix">sale.management</field></record>
  <record id="adapter_sale_renting" model="ai.integration.adapter"><field name="module_name">sale_renting</field><field name="label">Rental</field><field name="capability_prefix">sale.renting</field><field name="event_prefix">sale.renting</field></record>
  <record id="adapter_sale_subscription" model="ai.integration.adapter"><field name="module_name">sale_subscription</field><field name="label">Subscriptions</field><field name="capability_prefix">sale.subscription</field><field name="event_prefix">sale.subscription</field></record>
  <record id="adapter_website" model="ai.integration.adapter"><field name="module_name">website</field><field name="label">Website</field><field name="capability_prefix">website</field><field name="event_prefix">website</field></record>
  <record id="adapter_mass_mailing" model="ai.integration.adapter"><field name="module_name">mass_mailing</field><field name="label">Marketing</field><field name="capability_prefix">mass.mailing</field><field name="event_prefix">mass.mailing</field></record>
</odoo>
