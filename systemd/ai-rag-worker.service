[Unit]
Description=AI durable RAG indexing worker
After=postgresql.service redis-server.service ai-odoo.service
PartOf=ai-odoo.service
[Service]
Type=simple
User=odoo
Group=odoo
EnvironmentFile=-/etc/ai-box/runtime.env
ExecStart=/opt/odoo-custom-addons/ai-runtime-workers/run_rag_worker.sh
Restart=always
RestartSec=3
TimeoutStopSec=30
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
[Install]
WantedBy=multi-user.target
